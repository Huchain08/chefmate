// ChefMate — Prisma schema
// Database-driven content per instruction.md §2.1, §5
// Real relational database. Supabase provides PostgreSQL for development and production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Authentication & authorization
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  passwordHash      String?
  emailVerified     Boolean  @default(false)
  twoFactorEnabled  Boolean  @default(false)
  twoFactorSecret   String?
  failedLoginCount  Int      @default(0)
  lockedUntil       DateTime?
  lastLoginAt      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sessions          Session[]
  passwordResets    PasswordReset[]
  userRoles         UserRole[]
  auditLogs         AuditLog[]
  inventory         UserInventory[]
  favourites        UserFavourite[]
  mealPlans         MealPlan[]
  groceryLists      GroceryList[]
  contactSubmissions ContactSubmission[]
  uploads           UploadedFile[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  action      String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles       RolePermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  csrfToken    String
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  rotatedFrom  String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Site content (database-driven)
// ─────────────────────────────────────────────────────────────────────────────

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  type  String @default("string")
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model BusinessProfile {
  id            String  @id @default(cuid())
  name          String
  description   String?
  contactEmail  String?
  phoneNumber   String?
  streetAddress String?
  locality      String?
  region        String?
  postalCode    String?
  country       String?
  latitude      Float?
  longitude     Float?
  openingHours  String?
  logoUrl       String?
  faviconUrl    String?
  copyrightHolder String?
  primaryDomain String?
  socialLinks   String?
  updatedAt     DateTime @updatedAt
  updatedBy     String?
}

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  body        String
  heroText    String?
  layout      String   @default("default")
  status      String   @default("draft")
  approvedBy  String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seoMeta     SeoMeta?
  blocks      PageBlock[]

  @@index([status])
}

model PageBlock {
  id        String @id @default(cuid())
  pageId    String
  type      String
  heading   String?
  body      String?
  imageUrl  String?
  imageAlt  String?
  ctaText   String?
  ctaUrl    String?
  sortOrder Int    @default(0)
  metadata  String?

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

model NavigationItem {
  id        String  @id @default(cuid())
  label     String
  url       String
  parentId  String?
  sortOrder Int     @default(0)
  location  String  @default("header")
  requiresAuth Boolean @default(false)

  @@index([parentId])
  @@index([location])
}

model FooterLink {
  id        String  @id @default(cuid())
  label     String
  url       String
  section   String  @default("default")
  sortOrder Int     @default(0)

  @@index([section])
}

model MediaAsset {
  id          String   @id @default(cuid())
  filename    String
  storedName  String
  mimeType    String
  size        Int
  width       Int?
  height      Int?
  altText     String?
  url         String
  uploadedBy  String?
  createdAt   DateTime @default(now())

  @@index([mimeType])
}

model UploadedFile {
  id          String   @id @default(cuid())
  userId      String?
  filename    String
  storedName  String
  mimeType    String
  size        Int
  purpose     String
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model SeoMeta {
  id              String   @id @default(cuid())
  pageId          String   @unique
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?
  noIndex         Boolean  @default(false)
  keywords        String?
  updatedAt       DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model LegalDocument {
  id          String   @id @default(cuid())
  type        String   @unique
  title       String
  body        String
  version     Int      @default(1)
  status      String   @default("draft")
  approvedBy  String?
  publishedAt DateTime?
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  email     String
  subject   String?
  message   String
  ipAddress String?
  userAgent String?
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([handled])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String?
  resourceId String?
  ipAddress String?
  userAgent String?
  metadata  String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model RateLimitEvent {
  id        String   @id @default(cuid())
  key       String
  endpoint  String
  count     Int
  windowStart DateTime
  createdAt DateTime @default(now())

  @@index([key, endpoint, windowStart])
}

model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  permanent Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AnnouncementBanner {
  id        String   @id @default(cuid())
  message   String
  ctaText   String?
  ctaUrl    String?
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  startAt    DateTime?
  endAt      DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// ChefMate domain models
// ─────────────────────────────────────────────────────────────────────────────

model Ingredient {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  category  String
  unit      String   @default("piece")
  caloriesPerUnit Float?
  proteinG  Float?
  carbsG    Float?
  fatG      Float?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipeIngredients RecipeIngredient[]
  inventory         UserInventory[]
  groceryItems      GroceryItem[]

  @@index([category])
}

model Recipe {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String
  cuisine       String
  mealType      String
  course        String?
  difficulty    String   @default("easy")
  prepTimeMin   Int
  cookTimeMin   Int
  servings      Int      @default(2)
  caloriesPerServing Int?
  proteinG      Float?
  carbsG        Float?
  fatG          Float?
  imageUrl      String?
  imageAlt      String?
  videoUrl      String?
  sourceAttribution String?
  isTraditionalIndian Boolean @default(false)
  region        String?
  tags          String?
  rating        Float?
  ratingCount   Int?
  status        String   @default("published")
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ingredients   RecipeIngredient[]
  steps         RecipeStep[]
  favourites    UserFavourite[]
  mealPlans     MealPlan[]

  @@index([cuisine])
  @@index([mealType])
  @@index([status])
  @@index([isTraditionalIndian])
}

model RecipeIngredient {
  id          String @id @default(cuid())
  recipeId    String
  ingredientId String
  quantity    Float
  unit        String
  optional    Boolean @default(false)
  note        String?

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([recipeId])
  @@index([ingredientId])
}

model RecipeStep {
  id          String  @id @default(cuid())
  recipeId    String
  stepNumber  Int
  instruction String
  durationMin Int?
  temperature String?
  technique   String?

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model UserInventory {
  id           String  @id @default(cuid())
  userId       String
  ingredientId String
  quantity     Float
  unit         String
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([userId, ingredientId])
  @@index([userId])
}

model UserFavourite {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
}

model MealPlan {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  mealType  String
  recipeId  String
  servings  Int      @default(1)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, date, mealType])
  @@index([userId, date])
}

model GroceryList {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("My Grocery List")
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items GroceryItem[]

  @@index([userId])
}

model GroceryItem {
  id           String  @id @default(cuid())
  groceryListId String
  ingredientId String?
  name         String
  quantity     Float
  unit         String
  purchased    Boolean @default(false)
  note         String?
  createdAt    DateTime @default(now())

  groceryList GroceryList @relation(fields: [groceryListId], references: [id], onDelete: Cascade)
  ingredient  Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@index([groceryListId])
}
