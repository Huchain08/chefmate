# ChefMate local environment
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=ChefMate
NEXT_PUBLIC_PRIMARY_DOMAIN=localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase PostgreSQL connection strings
# Get these from Supabase -> Project Settings -> Database -> Connection string
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:<password>@<db-host>:5432/postgres"

# Generate two different values with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-secret
PASSWORD_RESET_SECRET=replace-with-a-different-long-random-secret
COOKIE_SECURE=false

ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=3
RATE_LIMIT_CONTACT_PER_HOUR=5
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_API_PER_MIN=60

UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# Optional integrations
YOUTUBE_API_KEY=
YOUTUBE_SEARCH_BASE_QUERY=recipe
GROCERY_PROVIDER=
GROCERY_API_KEY=
GROCERY_API_BASE_URL=
GROCERY_PARTNER_NAME=
VISION_PROVIDER=
VISION_MODEL=
OWNER_CONTACT_EMAIL=you@example.com
AUDIT_LOG_PATH=./logs/audit.log
